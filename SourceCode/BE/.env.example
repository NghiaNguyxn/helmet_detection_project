# Database
SQLITE_URL=sqlite:///./sql_database.db
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/<database>?appName=<app-name>
DATABASE_NAME=helmet_db
VIOLATION_COLLECTION=violations
TRAFFIC_STATS_COLLECTION=traffic_stats

# Initial Admin Account
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=replace-with-a-strong-password

# Authentication / JWT
# SECRET_KEY phải có ít nhất 32 ký tự.
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Inference
# INFERENCE_DEVICE có thể là 0, 1, cpu, cuda,...
# Giảm RTSP_INFERENCE_SIZE nếu dùng camera điện thoại hoặc máy yếu.
MODEL_PATH=SourceCode/BE/app/weights/best_s.onnx
INFERENCE_DEVICE=0
INFERENCE_HALF=True
IMAGE_INFERENCE_SIZE=640
VIDEO_INFERENCE_SIZE=640
RTSP_INFERENCE_SIZE=416

# Violation Detection / Deduplication
# DEMO_VIOLATION_COOLDOWN_SECONDS giúp video demo không spam record.
# Chỉ đặt 0 khi cần test nhanh việc tạo violation từ video demo.
VIOLATION_THRESHOLD=0.45
ALERT_COOLDOWN=60
VIOLATION_DIR=violations
DEMO_VIOLATION_COOLDOWN_SECONDS=120
VIOLATION_DEDUP_SECONDS=2.0
VIOLATION_DEDUP_IOU_THRESHOLD=0.15
VIOLATION_DEDUP_CENTER_DISTANCE=120
ENABLE_SPATIAL_VOTING=False
SPATIAL_VOTE_WINDOW_SECONDS=1.0
SPATIAL_VOTE_MIN_COUNT=3
SPATIAL_VOTE_IOU_THRESHOLD=0.2
SPATIAL_VOTE_CENTER_DISTANCE=120

# ByteTrack Tracker
# MATCH_THRESH thấp hơn có thể giúp giữ ID ổn định hơn khi đối tượng di chuyển nhanh.
TRACK_HIGH_THRESH=0.5
TRACK_LOW_THRESH=0.2
NEW_TRACK_THRESH=0.7
TRACK_BUFFER=60
MATCH_THRESH=0.5

# Camera / RTSP
# RTSP_TRANSPORT: tcp thường ổn định hơn, udp có thể giảm trễ nếu mạng tốt.
# RTSP_CAPTURE_BUFFER_SIZE=1 giúp backend đọc gần frame mới nhất.
# Camera trong .env chỉ là fallback khi DB chưa có camera active.
# Format: CAM_CODE=source_url;friendly-name
RTSP_TRANSPORT=tcp
RTSP_CAPTURE_BUFFER_SIZE=1
CAM_1=0;Default Webcam
# CAM_2=rtsp://192.168.1.9:8080/h264_pcm.sdp;Phone Camera

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email
MAIL_SERVER=smtp.example.com
MAIL_USERNAME=your-mail-username
MAIL_PASSWORD=your-mail-password
MAIL_PORT=587
MAIL_FROM=no-reply@example.com

# Frontend / CORS
# CORS_ORIGINS phải là JSON array vì kiểu dữ liệu trong config.py là list[str].
FRONTEND_URL=http://localhost:5173
FRONTEND_VERIFY_PATH=/verify-email
FRONTEND_RESET_PASSWORD_PATH=/reset-password
CORS_ORIGINS=["http://localhost:5173"]
